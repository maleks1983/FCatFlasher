<Window
    x:Class="FCatFlasher.BoxCompletedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Коробку заповнено"
    Width="422"
    Height="294"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                Margin="0,0,0,20"
                FontSize="20"
                FontWeight="Bold"
                Text="Коробку заповнено" />

            <TextBlock
                Margin="0,0,0,10"
                FontWeight="Bold"
                Text="{Binding BoxNumber, StringFormat=Коробка №{0}}" />

            <TextBlock Margin="0,0,0,10" Text="{Binding SerialRangeText, StringFormat=Діапазон: {0}}" />

            <TextBlock Margin="0,0,0,10" Text="{Binding Quantity, StringFormat=Кількість: {0}}" />

            <TextBlock Margin="0,0,0,10" Text="{Binding FirmwareName, StringFormat=Прошивка: {0}}" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="100"
                Margin="0,0,10,0"
                Click="Print_Click"
                Content="Друкувати" />

            <Button
                Width="100"
                Margin="0,0,10,0"
                Click="Continue_Click"
                Content="Продовжити" />

            <Button
                Width="100"
                Click="Finish_Click"
                Content="Завершити" />
        </StackPanel>
    </Grid>
</Window>