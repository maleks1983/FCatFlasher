<Window
    x:Class="FCatFlasher.EditBoxBoardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Редагування коробки"
    Width="430"
    Height="245"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="DescriptionText"
            Margin="0,0,0,14"
            FontSize="15"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <StackPanel x:Name="OldSerialPanel" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="OldSerialLabel" Margin="0,0,0,4" Text="Серійний номер плати, яку замінюємо" />
            <TextBox x:Name="OldSerialTextBox" Height="28" />
        </StackPanel>

        <StackPanel x:Name="NewSerialPanel" Grid.Row="2">
            <TextBlock Margin="0,0,0,4" Text="Серійний номер нової плати" />
            <TextBox x:Name="NewSerialTextBox" Height="28" />
        </StackPanel>

        <StackPanel
            Grid.Row="4"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button Width="95" Height="30" Margin="0,0,8,0" Click="Cancel_Click" Content="Скасувати" />
            <Button Width="95" Height="30" Click="Save_Click" Content="Зберегти" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
