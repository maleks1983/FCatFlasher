<Window x:Class="FCatFlasher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування"
        Height="280"
        Width="620"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="15">

        <TextBlock Text="COM порт"/>

        <StackPanel Orientation="Horizontal"
                    Margin="0,5,0,20">

            <ComboBox Width="140"
                      ItemsSource="{Binding ComPorts}"
                      SelectedItem="{Binding SelectedComPort}"/>

            <Button Content="Оновити"
                    Width="90"
                    Margin="30,0,0,0"
                    Command="{Binding RefreshComPortsCommand}"/>

        </StackPanel>

        <TextBlock Text="Папка тестових прошивок"/>

        <StackPanel Orientation="Horizontal"
                    Margin="0,5,0,12">

            <TextBox Width="460"
                     Height="25"
                     VerticalContentAlignment="Center"
                     Text="{Binding TestFirmwareDirectory, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Обрати"
                    Width="90"
                    Margin="15,0,0,0"
                    Command="{Binding BrowseTestFirmwareDirectoryCommand}"/>

        </StackPanel>

        <TextBlock Text="STM32Cube CLI"/>

        <StackPanel Orientation="Horizontal"
                    Margin="0,5,0,5">

            <TextBox Width="460"
                     Height="25"
                     VerticalContentAlignment="Center"
                     Text="{Binding StmCubeCliPath, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Обрати"
                    Width="90"
                    Margin="15,0,0,0"
                    Command="{Binding BrowseStmCubeCliCommand}"/>

        </StackPanel>

        <Button Content="OK"
                Width="90"
                Margin="0,12,0,0"
                IsCancel="True"/>

    </StackPanel>

</Window>
