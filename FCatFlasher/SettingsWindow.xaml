<Window x:Class="FCatFlasher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування"
        Height="170"
        Width="320"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="15">

        <TextBlock Text="COM порт"/>

        <StackPanel Orientation="Horizontal"
                    Margin="0,5,0,20">

            <ComboBox Width="140"
                      ItemsSource="{Binding ComPorts}"
                      SelectedItem="{Binding SelectedComPort}"/>

            <Button Content="Оновити"
                    Width="90"
                    Margin="30,0,0,0"
                    Command="{Binding RefreshComPortsCommand}"/>

        </StackPanel>
        <Button Content="OK"
                Width="90"
                Margin="0,20,0,0"
                IsCancel="True"/>

    </StackPanel>

</Window>