<Window
    x:Class="FCatFlasher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FCatFlasher"
    Width="950"
    Height="700"
    mc:Ignorable="d">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Вихід" />
            </MenuItem>

            <MenuItem Header="_Налаштування">
                <MenuItem Command="{Binding OpenSettingsCommand}" Header="Налаштування" />
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="248" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <TabControl
                Grid.Row="0"
                Margin="0,0,0,10"
                SelectionChanged="TabControl_SelectionChanged">

                <TabItem Header="Тестова прошивка">
                    <StackPanel Margin="10">

                        <TextBlock Margin="0,0,0,15" Text="Заливає тестову прошивку автоматично залежно від MCU" />

                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="200"
                                Height="35"
                                Margin="0,0,10,0"
                                Command="{Binding TestFirmwareCommand}"
                                Content="Залити тестову прошивку" />

                            <Button
                                Width="100"
                                Height="35"
                                Command="{Binding StopCommand}"
                                Content="Стоп" />
                        </StackPanel>

                    </StackPanel>
                </TabItem>

                <TabItem
                    Height="20"
                    VerticalAlignment="Top"
                    Header="Прошивка">
                    <Grid Margin="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="412" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Margin="0,0,0,5" Text="Серійний номер" />

                            <TextBox
                                Width="289"
                                Height="25"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                Text="{Binding ScannedSerial, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,0,0,5" Text="Прошивка" />

                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">

                                <TextBox
                                    Width="348"
                                    Height="30"
                                    Margin="0,0,10,0"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.IsColumnHeader="True"
                                    Text="{Binding FirmwarePath, UpdateSourceTrigger=PropertyChanged}" />

                                <Button
                                    Width="100"
                                    Command="{Binding BrowseFirmwareCommand}"
                                    Content="Обрати" />
                            </StackPanel>

                            <StackPanel Margin="0,25,0,0" Orientation="Horizontal">
                                <Button
                                    Width="160"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Command="{Binding FlashCommand}"
                                    Content="Запустити цикл" />

                                <Button
                                    Width="100"
                                    Height="35"
                                    Command="{Binding StopCommand}"
                                    Content="Стоп" />
                            </StackPanel>

                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="10"
                            BorderBrush="Gray"
                            BorderThickness="1">

                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="Додаткові налаштування" />

                                <TextBlock Margin="0,0,0,5" Text="Назва прошивки" />

                                <TextBox
                                    Height="25"
                                    Margin="0,0,0,10"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding FirmwareName, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,0,0,10">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">

                                        <TextBlock Margin="0,0,0,5" Text="Кількість в коробці" />

                                        <TextBox
                                            Height="25"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding BoxQuantityText, UpdateSourceTrigger=PropertyChanged}" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">

                                        <TextBlock Margin="0,0,0,5" Text="Запланована кількість" />

                                        <TextBox
                                            Height="25"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding PlannedQuantityText, UpdateSourceTrigger=PropertyChanged}" />

                                    </StackPanel>

                                </Grid>

                                <TextBlock Margin="0,10,0,0" Text="{Binding Status, StringFormat=Статус: \{0\}}" />
                            </StackPanel>

                        </Border>

                    </Grid>
                </TabItem>

                <TabItem Header="Перепрошивка">
                    <StackPanel Margin="10,0,10,0">

                        <TextBlock Margin="0,0,0,5" Text="Серійний номер" />

                        <TextBox
                            Width="300"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            FontSize="18"
                            Text="{Binding ScannedSerial, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,0,0,5" Text="Прошивка G0" />

                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">

                            <TextBox
                                Width="650"
                                Margin="0,0,10,0"
                                Text="{Binding G0FirmwarePath, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Width="100"
                                Command="{Binding BrowseG0FirmwareCommand}"
                                Content="Обрати" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,5" Text="Прошивка C0" />

                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">

                            <TextBox
                                Width="650"
                                Margin="0,0,10,0"
                                Text="{Binding C0FirmwarePath, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Width="100"
                                Command="{Binding BrowseC0FirmwareCommand}"
                                Content="Обрати" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="160"
                                Height="35"
                                Margin="0,0,10,0"
                                Command="{Binding ReflashCommand}"
                                Content="Перепрошити" />

                            <Button
                                Width="100"
                                Height="35"
                                Command="{Binding StopCommand}"
                                Content="Стоп" />
                        </StackPanel>

                    </StackPanel>
                </TabItem>

            </TabControl>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <!--  Лог  -->
                <TextBox
                    x:Name="LogTextBox"
                    Grid.Column="0"
                    AcceptsReturn="True"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    Text="{Binding Log}"
                    TextChanged="LogTextBox_TextChanged"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />

                <!--  Звіт  -->
                <Border
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="5"
                    BorderBrush="LightGray"
                    BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>

                        <!--  Заголовок  -->
                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,5"
                            Background="#E5E5E5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                FontWeight="Bold"
                                OpacityMask="Black"
                                Margin="5,0,0,5"
                                Text="id" />

                            <TextBlock
                                Grid.Column="1"
                                FontWeight="Bold"
                                Text="Діапазон" />

                            <TextBlock
                                Grid.Column="2"
                                FontWeight="Bold"
                                Text="К-сть" />

                            <TextBlock
                                Grid.Column="3"
                                FontWeight="Bold"
                                Text="Прошивка" />

                        </Grid>

                        <!--  Дані  -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding BoxReports}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Margin="0,2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding BoxNumber}" />

                                            <TextBlock Grid.Column="1" Text="{Binding SerialRangeText}" />

                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" />

                                            <TextBlock Grid.Column="3" Text="{Binding FirmwareName}" />

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Border>

            </Grid>

            <Border
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">

                <DockPanel>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{Binding FooterTitle}" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding FlashedToday}" />

                    <TextBlock
                        Margin="30,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Унікальних з запуску:" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding UniqueFlashedSinceStart}" />

                    <ProgressBar
                        Width="160"
                        Height="14"
                        Margin="30,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding ProgressValue}" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{Binding ProgressValue, StringFormat=\{0\}%}" />
                </DockPanel>


            </Border>

        </Grid>

    </DockPanel>
</Window>
