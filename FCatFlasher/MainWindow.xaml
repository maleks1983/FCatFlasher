<Window
    x:Class="FCatFlasher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FCatFlasher"
    Width="950"
    Height="700"
    mc:Ignorable="d">

    <DockPanel>

        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
            <TextBlock
                DockPanel.Dock="Right"
                Margin="12,0,12,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding CurrentUserName, StringFormat=Користувач: {0}}" />

            <Menu>
                <MenuItem Header="_Файл">
                    <MenuItem Header="Вихід" />
                </MenuItem>

                <MenuItem Header="_Налаштування">
                    <MenuItem Command="{Binding OpenSettingsCommand}" Header="Налаштування" />
                </MenuItem>

                <MenuItem Header="_Звіти">
                    <MenuItem Command="{Binding OpenProductionReportCommand}" Header="Звіт прошивка" />
                    <MenuItem Command="{Binding OpenReworkReportCommand}" Header="Звіт перепрошивка" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="285" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <TabControl
                Grid.Row="0"
                Margin="0,0,0,10"
                SelectionChanged="TabControl_SelectionChanged">

                <TabItem Header="Тестова прошивка">
                    <StackPanel Margin="10">

                        <TextBlock Margin="0,0,0,15" Text="Заливає тестову прошивку автоматично залежно від MCU" />

                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="200"
                                Height="35"
                                Margin="0,0,10,0"
                                Command="{Binding TestFirmwareCommand}"
                                Content="Залити тестову прошивку" />

                            <Button
                                Width="100"
                                Height="35"
                                Command="{Binding StopCommand}"
                                Content="Стоп" />
                        </StackPanel>

                    </StackPanel>
                </TabItem>

                <TabItem
                    Height="20"
                    VerticalAlignment="Top"
                    Header="Прошивка">
                    <Grid Margin="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Margin="0,0,0,5" Text="Серійний номер" />

                            <TextBox
                                x:Name="ProductionSerialTextBox"
                                Width="220"
                                Height="25"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                IsEnabled="{Binding IsSerialInputEnabled}"
                                Text="{Binding ScannedSerial, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabledChanged="SerialTextBox_IsEnabledChanged"
                                TextChanged="SerialTextBox_TextChanged" />

                            <TextBlock Margin="0,0,0,5" Text="Прошивка" />

                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">

                                <TextBox
                                    Width="348"
                                    Height="30"
                                    Margin="0,0,10,0"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.IsColumnHeader="True"
                                    Text="{Binding FirmwarePath, UpdateSourceTrigger=PropertyChanged}" />

                                <Button
                                    Width="100"
                                    Command="{Binding BrowseFirmwareCommand}"
                                    Content="Обрати" />
                            </StackPanel>

                            <StackPanel Margin="0,25,0,0" Orientation="Horizontal">
                                <Button
                                    Width="160"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Command="{Binding FlashCommand}"
                                    Content="Запустити цикл" />

                                <Button
                                    Width="100"
                                    Height="35"
                                    Command="{Binding StopCommand}"
                                    Content="Стоп" />
                            </StackPanel>

                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="10"
                            BorderBrush="Gray"
                            BorderThickness="1">

                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="Обрано для циклу" />

                                <TextBlock Margin="0,0,0,5" Text="Назва прошивки" />

                                <TextBlock
                                    MinHeight="24"
                                    Margin="0,0,0,10"
                                    Padding="4"
                                    Background="#F2F2F2"
                                    Text="{Binding FirmwareName}" />

                                <TextBlock Margin="0,0,0,5" Text="Кількість в коробці" />

                                <TextBlock
                                    MinHeight="24"
                                    Padding="4"
                                    Background="#F2F2F2"
                                    Text="{Binding BoxQuantityText}" />

                                <TextBlock Margin="0,16,0,0" Text="{Binding Status, StringFormat=Статус: \{0\}}" />
                            </StackPanel>

                        </Border>

                    </Grid>
                </TabItem>

                <TabItem Header="Перепрошивка">
                    <Grid Margin="10,0,10,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                        <TextBlock Margin="0,0,0,5" Text="Серійний номер" />

                        <TextBox
                            x:Name="ReflashSerialTextBox"
                            Width="220"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            FontSize="18"
                            IsEnabled="{Binding IsSerialInputEnabled}"
                            Text="{Binding ScannedSerial, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabledChanged="SerialTextBox_IsEnabledChanged"
                            TextChanged="SerialTextBox_TextChanged" />

                        <TextBlock Margin="0,0,0,5" Text="Прошивка G0" />

                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">

                            <TextBox
                                Width="446"
                                Margin="0,0,10,0"
                                Text="{Binding G0FirmwarePath, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Width="100"
                                Command="{Binding BrowseG0FirmwareCommand}"
                                Content="Обрати" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,5" Text="Прошивка C0" />

                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">

                            <TextBox
                                Width="446"
                                Margin="0,0,10,0"
                                Text="{Binding C0FirmwarePath, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Width="100"
                                Command="{Binding BrowseC0FirmwareCommand}"
                                Content="Обрати" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="160"
                                Height="35"
                                Margin="0,0,10,0"
                                Command="{Binding ReflashCommand}"
                                Content="Перепрошити" />

                            <Button
                                Width="190"
                                Height="35"
                                Margin="0,0,10,0"
                                Command="{Binding ReflashTestFirmwareCommand}"
                                Content="Тестова перепрошивка" />

                            <Button
                                Width="100"
                                Height="35"
                                Command="{Binding StopCommand}"
                                Content="Стоп" />
                        </StackPanel>

                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="10"
                            BorderBrush="Gray"
                            BorderThickness="1">

                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="Обрано для перепрошивки" />

                                <TextBlock Margin="0,0,0,5" Text="ID замовлення" />

                                <TextBlock
                                    MinHeight="24"
                                    Margin="0,0,0,10"
                                    Padding="4"
                                    Background="#F2F2F2"
                                    Text="{Binding ReworkOrderId}" />

                                <TextBlock Margin="0,0,0,5" Text="Назва прошивки" />

                                <TextBox
                                    MinHeight="24"
                                    Padding="4"
                                    Text="{Binding ReworkFirmwareName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,16,0,0" Text="{Binding Status, StringFormat=Статус: \{0\}}" />
                            </StackPanel>

                        </Border>

                    </Grid>
                </TabItem>

            </TabControl>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <!--  Лог  -->
                <TextBox
                    x:Name="LogTextBox"
                    Grid.Column="0"
                    AcceptsReturn="True"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    Text="{Binding Log}"
                    TextChanged="LogTextBox_TextChanged"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />

                <!--  Локальні дані  -->
                <Border
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="5"
                    BorderBrush="LightGray"
                    BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />

                            </Grid.RowDefinitions>

                        <!--  Заголовок  -->
                        <DockPanel
                            Grid.Row="0"
                            Margin="0,0,0,6">

                            <Button
                                DockPanel.Dock="Right"
                                Width="125"
                                Height="24"
                                Command="{Binding SyncPendingCommand}"
                                Content="Синхронізувати" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="Локальні дані" />

                        </DockPanel>

                        <Grid
                            Grid.Row="0"
                            Margin="0,24,0,0"
                            MinWidth="585"
                            Background="#E5E5E5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="5,0,0,2"
                                FontWeight="Bold"
                                Text="{Binding LocalDataHeader1}" />

                            <TextBlock
                                Grid.Column="1"
                                FontWeight="Bold"
                                Text="{Binding LocalDataHeader2}" />

                            <TextBlock
                                Grid.Column="2"
                                FontWeight="Bold"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding LocalDataHeader3}" />

                            <TextBlock
                                Grid.Column="3"
                                FontWeight="Bold"
                                Text="{Binding LocalDataHeader4}" />

                            <TextBlock Grid.Column="4" />

                        </Grid>

                        <!--  Дані  -->
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">

                            <StackPanel MinWidth="585">

                            <TextBlock
                                Margin="5,4,0,0"
                                Foreground="Gray"
                                Text="{Binding LocalDataEmptyText}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl
                                AlternationCount="2"
                                ItemsSource="{Binding LocalDataRows}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Margin="0,1">

                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Background" Value="White" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                            Value="1">
                                                            <Setter Property="Background" Value="#F0F0F0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="45" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Column1}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Column2}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding Column3}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{Binding Column4}"
                                                TextTrimming="CharacterEllipsis" />

                                            <Button
                                                Grid.Column="4"
                                                Width="24"
                                                Height="20"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.DeleteLocalDataRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="X">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            </StackPanel>

                        </ScrollViewer>

                    </Grid>

                </Border>

            </Grid>

            <Border
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">

                <DockPanel>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{Binding FooterTitle}" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding FlashedToday}" />

                    <TextBlock
                        Margin="30,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Час:" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding RunElapsedText}" />

                    <TextBlock
                        Margin="30,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Унікальних з запуску:" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding UniqueFlashedSinceStart}" />

                    <ProgressBar
                        Width="160"
                        Height="14"
                        Margin="30,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding ProgressValue}" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{Binding ProgressValue, StringFormat=\{0\}%}" />
                </DockPanel>


            </Border>

        </Grid>

    </DockPanel>
</Window>
